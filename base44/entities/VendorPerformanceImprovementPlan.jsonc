{
  "name": "VendorPerformanceImprovementPlan",
  "type": "object",
  "properties": {
    "vendor_id": {
      "type": "string"
    },
    "vendor_name": {
      "type": "string"
    },
    "vendor_relationship_id": {
      "type": "string"
    },
    "vendor_relationship_name": {
      "type": "string"
    },
    "vendor_evaluation_id": {
      "type": "string"
    },
    "vendor_evaluation_name": {
      "type": "string"
    },
    "performance_issue": {
      "type": "string"
    },
    "root_cause": {
      "type": "string"
    },
    "required_corrective_action": {
      "type": "string"
    },
    "responsible_vendor_representative": {
      "type": "string"
    },
    "responsible_client_leader": {
      "type": "string"
    },
    "target_completion_date": {
      "type": "string",
      "format": "date"
    },
    "evidence_required": {
      "type": "string"
    },
    "monitoring_method": {
      "type": "string"
    },
    "service_level_expectation": {
      "type": "string"
    },
    "escalation_threshold": {
      "type": "string"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date"
    },
    "current_status": {
      "type": "string",
      "enum": [
        "Draft",
        "Submitted to Vendor",
        "Acknowledged",
        "In Progress",
        "Evidence Submitted",
        "Under Review",
        "Monitoring",
        "Completed",
        "Overdue",
        "Escalated",
        "Closed"
      ],
      "default": "Draft"
    },
    "closure_approval": {
      "type": "string"
    },
    "override_rationale": {
      "type": "string"
    },
    "qapi_review": {
      "type": "string"
    },
    "client_visibility": {
      "type": "boolean",
      "default": false,
      "title": "Client Visible"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "is_test_data": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "performance_issue",
    "current_status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "business_development"
          }
        },
        {
          "user_condition": {
            "role": "clinical"
          }
        },
        {
          "user_condition": {
            "role": "read_only"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "clinical"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "clinical"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}