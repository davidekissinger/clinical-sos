{
  "name": "Proposal",
  "type": "object",
  "properties": {
    "proposal_name": {
      "type": "string"
    },
    "opportunity_id": {
      "type": "string"
    },
    "facility_id": {
      "type": "string"
    },
    "facility_name": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "objectives": {
      "type": "string"
    },
    "phases": {
      "type": "string"
    },
    "deliverables": {
      "type": "string"
    },
    "engagement_model": {
      "type": "string",
      "enum": [
        "Fixed Fee",
        "Hourly",
        "Time and Expense",
        "Hybrid"
      ]
    },
    "pricing_method": {
      "type": "string"
    },
    "fee": {
      "type": "number"
    },
    "payment_milestones": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "In Review",
        "Approved",
        "Sent",
        "Accepted",
        "Rejected",
        "Expired"
      ]
    },
    "generated_date": {
      "type": "string",
      "format": "date-time"
    },
    "reviewer_id": {
      "type": "string"
    },
    "reviewer_name": {
      "type": "string"
    },
    "sent_date": {
      "type": "string",
      "format": "date-time"
    },
    "acceptance_status": {
      "type": "string",
      "enum": [
        "Pending",
        "Accepted",
        "Rejected"
      ]
    },
    "is_test_data": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "proposal_name",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "business_development"
          }
        },
        {
          "user_condition": {
            "role": "clinical"
          }
        },
        {
          "user_condition": {
            "role": "read_only"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "finance"
              }
            },
            {
              "data.status": {
                "$in": [
                  "Approved",
                  "Sent",
                  "Accepted"
                ]
              }
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "business_development"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "business_development"
          }
        },
        {
          "user_condition": {
            "role": "clinical"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}