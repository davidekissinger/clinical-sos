{
  "name": "Deficiency",
  "type": "object",
  "properties": {
    "regulatory_case_id": {
      "type": "string"
    },
    "regulatory_case_name": {
      "type": "string"
    },
    "engagement_id": {
      "type": "string",
      "title": "Engagement ID"
    },
    "engagement_name": {
      "type": "string",
      "title": "Engagement Name"
    },
    "facility_id": {
      "type": "string"
    },
    "facility_name": {
      "type": "string"
    },
    "f_tag": {
      "type": "string",
      "title": "F-Tag"
    },
    "regulation_reference": {
      "type": "string"
    },
    "regulatory_knowledge_id": {
      "type": "string",
      "title": "Linked Regulatory Knowledge Record"
    },
    "regulatory_mapping_verified": {
      "type": "boolean",
      "default": false,
      "title": "Regulatory Mapping Verified"
    },
    "deficiency_title": {
      "type": "string"
    },
    "scope_severity": {
      "type": "string",
      "title": "Scope & Severity (source wording)"
    },
    "scope_severity_letter": {
      "type": "string",
      "title": "Scope & Severity Letter",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F",
        "G",
        "H",
        "I",
        "J",
        "K",
        "L",
        "Unknown",
        ""
      ]
    },
    "harm_level": {
      "type": "string",
      "title": "Harm Level",
      "enum": [
        "No actual harm with potential for minimal harm",
        "Minimal harm",
        "No actual harm with potential for more than minimal harm",
        "Actual harm",
        "Immediate jeopardy",
        "Unknown",
        ""
      ]
    },
    "scope_level": {
      "type": "string",
      "title": "Scope",
      "enum": [
        "Isolated",
        "Pattern",
        "Widespread",
        "Unknown",
        ""
      ]
    },
    "immediate_jeopardy": {
      "type": "string",
      "enum": [
        "Yes",
        "No",
        "Unknown"
      ],
      "default": "Unknown"
    },
    "source_cms_2567": {
      "type": "string",
      "title": "Source CMS-2567"
    },
    "page_reference": {
      "type": "string"
    },
    "survey_finding": {
      "type": "string"
    },
    "factual_summary": {
      "type": "string"
    },
    "affected_residents_deidentified": {
      "type": "string",
      "title": "Affected Residents (De-identified)"
    },
    "deficiency_date": {
      "type": "string",
      "format": "date"
    },
    "regulatory_focus": {
      "type": "string"
    },
    "clinical_significance": {
      "type": "string"
    },
    "immediate_safety_concern": {
      "type": "boolean",
      "default": false
    },
    "likely_contributing_factors": {
      "type": "string"
    },
    "root_cause_categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "systemic_issue": {
      "type": "boolean",
      "default": false
    },
    "policy_process_issue": {
      "type": "boolean",
      "default": false
    },
    "staffing_issue": {
      "type": "boolean",
      "default": false
    },
    "competency_issue": {
      "type": "boolean",
      "default": false
    },
    "documentation_issue": {
      "type": "boolean",
      "default": false
    },
    "oversight_accountability_issue": {
      "type": "boolean",
      "default": false
    },
    "other_relevant_factor": {
      "type": "string"
    },
    "immediate_correction": {
      "type": "string"
    },
    "potentially_affected_population": {
      "type": "string"
    },
    "systemic_correction": {
      "type": "string"
    },
    "education_training": {
      "type": "string"
    },
    "competency_validation": {
      "type": "string"
    },
    "audit_monitoring": {
      "type": "string"
    },
    "evidence_needed": {
      "type": "string"
    },
    "responsible_leader": {
      "type": "string"
    },
    "target_completion_date": {
      "type": "string",
      "format": "date"
    },
    "qapi_oversight": {
      "type": "string"
    },
    "revisit_readiness_status": {
      "type": "string",
      "enum": [
        "Ready",
        "Nearly Ready",
        "Significant Gaps",
        "Not Ready",
        "Not Assessed"
      ],
      "default": "Not Assessed"
    },
    "revisit_readiness_score": {
      "type": "number",
      "title": "Revisit Readiness Score (0-100)"
    },
    "revisit_readiness_explanation": {
      "type": "string",
      "title": "Revisit Readiness Explanation"
    },
    "deficiency_status": {
      "type": "string",
      "enum": [
        "Draft",
        "Clinical Review",
        "Client Review",
        "Approved",
        "Implementation",
        "Evidence Pending",
        "Monitoring",
        "Revisit Ready",
        "Closed"
      ],
      "default": "Draft"
    },
    "closure_override": {
      "type": "boolean",
      "default": false,
      "title": "Closure Override Applied"
    },
    "closure_override_reason": {
      "type": "string",
      "title": "Closure Override Reason"
    },
    "closure_override_by": {
      "type": "string",
      "title": "Closure Override By"
    },
    "closure_override_date": {
      "type": "string",
      "format": "date-time"
    },
    "priority_ranking": {
      "type": "number"
    },
    "priority_explanation": {
      "type": "string"
    },
    "client_visibility": {
      "type": "boolean",
      "default": false,
      "title": "Client Visible"
    },
    "is_test_data": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "regulatory_case_id",
    "f_tag",
    "deficiency_status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "clinical"
          }
        },
        {
          "user_condition": {
            "role": "read_only"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "clinical"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "clinical"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}