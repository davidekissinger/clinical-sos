{
  "name": "LeadEngineConfig",
  "type": "object",
  "properties": {
    "active_states": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_geography": {
      "type": "string"
    },
    "minimum_lead_score": {
      "type": "number"
    },
    "regulatory_lookback_days": {
      "type": "number"
    },
    "signal_weights": {
      "type": "object",
      "properties": {
        "immediate_jeopardy": {
          "type": "number"
        },
        "cmp": {
          "type": "number"
        },
        "dpna": {
          "type": "number"
        },
        "sff": {
          "type": "number"
        },
        "repeat_deficiency": {
          "type": "number"
        },
        "infection_control": {
          "type": "number"
        },
        "low_rating": {
          "type": "number"
        },
        "follow_up_survey": {
          "type": "number"
        },
        "ownership_change": {
          "type": "number"
        },
        "leadership_signal": {
          "type": "number"
        }
      }
    },
    "data_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "refresh_frequency_hours": {
      "type": "number"
    },
    "outreach_mode": {
      "type": "string",
      "enum": [
        "Research Only",
        "Human Approved Outreach",
        "Approved Automated Sequence"
      ],
      "default": "Human Approved Outreach"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_email": {
      "type": "string"
    },
    "follow_up_intervals": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "daily_outreach_limit": {
      "type": "number"
    },
    "bd_owner_id": {
      "type": "string"
    },
    "bd_owner_name": {
      "type": "string"
    },
    "clinical_owner_id": {
      "type": "string"
    },
    "clinical_owner_name": {
      "type": "string"
    },
    "finance_owner_id": {
      "type": "string"
    },
    "finance_owner_name": {
      "type": "string"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    },
    "test_mode": {
      "type": "boolean",
      "default": false
    },
    "test_email_recipients": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "regulatory_urgency_weights": {
      "type": "object",
      "title": "Regulatory Urgency Score Weights",
      "properties": {
        "immediate_jeopardy": {
          "type": "number"
        },
        "cmp_per_day": {
          "type": "number"
        },
        "cmp_per_instance": {
          "type": "number"
        },
        "dpna": {
          "type": "number"
        },
        "sff_active": {
          "type": "number"
        },
        "sff_candidate": {
          "type": "number"
        },
        "repeat_serious_deficiency": {
          "type": "number"
        },
        "failed_revisit": {
          "type": "number"
        },
        "upcoming_revisit": {
          "type": "number"
        },
        "infection_control": {
          "type": "number"
        },
        "high_severity": {
          "type": "number"
        },
        "medium_severity": {
          "type": "number"
        },
        "low_severity": {
          "type": "number"
        },
        "unresolved": {
          "type": "number"
        },
        "recency_multiplier_max": {
          "type": "number"
        },
        "verification_multiplier": {
          "type": "number"
        },
        "multi_facility_operator_bonus": {
          "type": "number"
        }
      }
    },
    "commercial_opportunity_weights": {
      "type": "object",
      "title": "Commercial Opportunity Score Weights",
      "properties": {
        "service_match": {
          "type": "number"
        },
        "operator_size": {
          "type": "number"
        },
        "multi_facility_affected": {
          "type": "number"
        },
        "decision_maker_identified": {
          "type": "number"
        },
        "geographic_fit": {
          "type": "number"
        },
        "urgency_alignment": {
          "type": "number"
        },
        "engagement_potential": {
          "type": "number"
        },
        "prior_interaction": {
          "type": "number"
        },
        "response_history": {
          "type": "number"
        }
      }
    },
    "priority_score_weights": {
      "type": "object",
      "title": "Clinical SOS Priority Score Weights",
      "properties": {
        "regulatory_urgency_weight": {
          "type": "number"
        },
        "commercial_opportunity_weight": {
          "type": "number"
        }
      }
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "outreach_mode"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "business_development"
          }
        },
        {
          "user_condition": {
            "role": "clinical"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        },
        {
          "user_condition": {
            "role": "read_only"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}