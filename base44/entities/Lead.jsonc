{
  "name": "Lead",
  "type": "object",
  "properties": {
    "facility_id": {
      "type": "string"
    },
    "facility_name": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "organization_name": {
      "type": "string"
    },
    "primary_contact_id": {
      "type": "string"
    },
    "primary_contact_name": {
      "type": "string"
    },
    "lead_source": {
      "type": "string"
    },
    "regulatory_signal_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lead_score": {
      "type": "number"
    },
    "lead_tier": {
      "type": "string",
      "enum": [
        "Tier 1",
        "Tier 2",
        "Tier 3",
        "Nurture"
      ]
    },
    "score_explanation": {
      "type": "string"
    },
    "regulatory_urgency": {
      "type": "string",
      "enum": [
        "Critical",
        "Severe",
        "High",
        "Moderate",
        "Proactive",
        "Unknown / Research Required"
      ],
      "default": "Unknown / Research Required"
    },
    "regulatory_urgency_score": {
      "type": "number"
    },
    "commercial_opportunity_score": {
      "type": "number"
    },
    "clinical_sos_priority_score": {
      "type": "number"
    },
    "score_breakdown": {
      "type": "string",
      "title": "Score Breakdown (JSON)"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "Unverified",
        "Verified",
        "Research Required",
        "Suppressed"
      ]
    },
    "recommended_service": {
      "type": "string"
    },
    "potential_urgency": {
      "type": "string",
      "enum": [
        "General Inquiry",
        "Proactive",
        "Corrective Action",
        "Operational",
        "Leadership",
        "Regulatory",
        "Urgent"
      ]
    },
    "owner_id": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "next_action": {
      "type": "string"
    },
    "next_action_date": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "is_test_data": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "facility_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "business_development"
          }
        },
        {
          "user_condition": {
            "role": "read_only"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "business_development"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "business_development"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}