{
  "name": "ClientMembership",
  "type": "object",
  "properties": {
    "client_user_id": {
      "type": "string",
      "title": "Client User ID"
    },
    "client_user_name": {
      "type": "string",
      "title": "Client User Name"
    },
    "client_user_email": {
      "type": "string",
      "title": "Client User Email"
    },
    "client_account_id": {
      "type": "string",
      "title": "Client Account ID"
    },
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "organization_name": {
      "type": "string",
      "title": "Organization Name"
    },
    "authorized_facility_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Authorized Facility IDs"
    },
    "authorized_engagement_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Authorized Engagement IDs"
    },
    "membership_status": {
      "type": "string",
      "enum": [
        "Invited",
        "Active",
        "Suspended",
        "Revoked",
        "Expired"
      ],
      "default": "Invited",
      "title": "Membership Status"
    },
    "can_login": {
      "type": "boolean",
      "default": true,
      "title": "Can Login"
    },
    "can_view_engagement": {
      "type": "boolean",
      "default": true,
      "title": "Can View Engagement"
    },
    "can_view_documents": {
      "type": "boolean",
      "default": true,
      "title": "Can View Documents"
    },
    "can_download_documents": {
      "type": "boolean",
      "default": true,
      "title": "Can Download Documents"
    },
    "can_view_poc": {
      "type": "boolean",
      "default": true,
      "title": "Can View POC"
    },
    "can_review_poc": {
      "type": "boolean",
      "default": true,
      "title": "Can Review POC"
    },
    "can_approve_poc": {
      "type": "boolean",
      "default": false,
      "title": "Can Approve POC"
    },
    "can_view_tasks": {
      "type": "boolean",
      "default": true,
      "title": "Can View Tasks"
    },
    "can_complete_tasks": {
      "type": "boolean",
      "default": false,
      "title": "Can Complete Tasks"
    },
    "can_view_evidence": {
      "type": "boolean",
      "default": true,
      "title": "Can View Evidence"
    },
    "can_submit_evidence": {
      "type": "boolean",
      "default": false,
      "title": "Can Submit Evidence"
    },
    "can_view_audits": {
      "type": "boolean",
      "default": true,
      "title": "Can View Audits"
    },
    "can_complete_audits": {
      "type": "boolean",
      "default": false,
      "title": "Can Complete Audits"
    },
    "can_message_consultant": {
      "type": "boolean",
      "default": true,
      "title": "Can Message Consultant"
    },
    "invited_date": {
      "type": "string",
      "format": "date-time",
      "title": "Invited Date"
    },
    "activated_date": {
      "type": "string",
      "format": "date-time",
      "title": "Activated Date"
    },
    "suspended_date": {
      "type": "string",
      "format": "date-time",
      "title": "Suspended Date"
    },
    "revoked_date": {
      "type": "string",
      "format": "date-time",
      "title": "Revoked Date"
    },
    "suspension_reason": {
      "type": "string",
      "title": "Suspension Reason"
    },
    "revocation_reason": {
      "type": "string",
      "title": "Revocation Reason"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "client_user_id",
    "client_account_id",
    "membership_status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        },
        {
          "user_condition": {
            "role": "clinical"
          }
        },
        {
          "user_condition": {
            "role": "read_only"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}