{
  "name": "EvidenceItem",
  "type": "object",
  "properties": {
    "deficiency_id": {
      "type": "string"
    },
    "deficiency_name": {
      "type": "string"
    },
    "regulatory_case_id": {
      "type": "string"
    },
    "regulatory_case_name": {
      "type": "string"
    },
    "facility_id": {
      "type": "string"
    },
    "facility_name": {
      "type": "string"
    },
    "engagement_id": {
      "type": "string",
      "title": "Engagement ID"
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "Corrected Resident-Specific Documentation",
        "Policy Revision",
        "Care-Plan Revision",
        "Physician Orders",
        "Equipment Correction",
        "Inspection Record",
        "Training Materials",
        "Attendance Roster",
        "Competency Validation",
        "Completed Audit",
        "Follow-Up Correction",
        "Photograph",
        "Log",
        "Leadership Rounding",
        "QAPI Documentation",
        "Consultant Review",
        "Other Supporting Evidence"
      ]
    },
    "description": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "source": {
      "type": "string"
    },
    "responsible_person": {
      "type": "string"
    },
    "uploaded_document_url": {
      "type": "string"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "Required",
        "Requested",
        "Received",
        "Under Review",
        "Accepted",
        "Insufficient",
        "Replaced",
        "Not Applicable"
      ],
      "default": "Required"
    },
    "reviewer": {
      "type": "string"
    },
    "accepted_as_sufficient": {
      "type": "boolean",
      "default": false
    },
    "client_response_status": {
      "type": "string",
      "enum": [
        "Pending",
        "Prepared",
        "Available",
        "Clarification Requested",
        "Noted"
      ],
      "default": "Pending",
      "title": "Client Response Status"
    },
    "client_response_note": {
      "type": "string",
      "title": "Client Response Note"
    },
    "client_responded_by": {
      "type": "string",
      "title": "Client Responded By"
    },
    "client_responded_by_id": {
      "type": "string",
      "title": "Client Responded By (User ID)"
    },
    "client_response_date": {
      "type": "string",
      "format": "date-time",
      "title": "Client Response Date"
    },
    "notes": {
      "type": "string"
    },
    "client_visibility": {
      "type": "boolean",
      "default": false,
      "title": "Client Visible"
    },
    "is_test_data": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "facility_name",
    "evidence_type",
    "review_status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "clinical"
          }
        },
        {
          "user_condition": {
            "role": "read_only"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "client"
              }
            },
            {
              "data.client_visibility": true
            },
            {
              "data.facility_id": {
                "$in": "{{user.data.authorized_facility_ids}}"
              }
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "clinical"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "clinical"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}