{
  "name": "LaunchReadinessCheck",
  "type": "object",
  "properties": {
    "check_name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Security",
        "Privacy",
        "Verification",
        "Communication",
        "Workflow",
        "Infrastructure"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "WARNING",
        "FAIL"
      ],
      "default": "WARNING"
    },
    "last_tested_date": {
      "type": "string",
      "format": "date-time"
    },
    "evidence": {
      "type": "string"
    },
    "unresolved_issue": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "is_critical": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "check_name",
    "category",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}