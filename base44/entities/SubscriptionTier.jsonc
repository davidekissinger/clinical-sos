{
  "name": "SubscriptionTier",
  "type": "object",
  "properties": {
    "tier_name": {
      "type": "string",
      "title": "Tier Display Name"
    },
    "tier_key": {
      "type": "string",
      "title": "Tier Key (slug)"
    },
    "description": {
      "type": "string"
    },
    "annual_price": {
      "type": "number",
      "title": "Annual Price (USD)"
    },
    "stripe_product_id": {
      "type": "string",
      "title": "Stripe Product ID"
    },
    "stripe_price_id": {
      "type": "string",
      "title": "Stripe Price ID"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "included_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Included Client Capabilities"
    },
    "facility_limit": {
      "type": "number",
      "title": "Facility Limit (0 = unlimited)"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_test_data": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "tier_name",
    "tier_key",
    "annual_price",
    "stripe_price_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        },
        {
          "user_condition": {
            "role": "client"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}