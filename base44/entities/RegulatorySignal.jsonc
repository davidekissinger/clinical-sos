{
  "name": "RegulatorySignal",
  "type": "object",
  "properties": {
    "facility_id": {
      "type": "string"
    },
    "facility_name": {
      "type": "string"
    },
    "ccn": {
      "type": "string"
    },
    "signal_type": {
      "type": "string",
      "enum": [
        "Immediate Jeopardy",
        "CMP",
        "DPNA",
        "Special Focus Facility",
        "SFF Candidate",
        "Repeat Deficiency",
        "Infection-Control Deficiency",
        "Low Health Inspection Rating",
        "Follow-Up Survey",
        "Ownership Change",
        "Leadership/Operational Signal",
        "Other Regulatory Signal"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "High",
        "Medium",
        "Low"
      ]
    },
    "event_date": {
      "type": "string",
      "format": "date"
    },
    "source": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "date_retrieved": {
      "type": "string",
      "format": "date-time"
    },
    "factual_evidence_summary": {
      "type": "string"
    },
    "enforcement_amount": {
      "type": "number"
    },
    "deficiency_tag": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Current",
        "Resolved",
        "Unknown"
      ]
    },
    "confidence_score": {
      "type": "number"
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "verification_method": {
      "type": "string"
    },
    "stale_data_flag": {
      "type": "boolean",
      "default": false
    },
    "reviewer": {
      "type": "string"
    },
    "reviewer_id": {
      "type": "string"
    },
    "is_test_data": {
      "type": "boolean",
      "default": false
    },
    "cmp_type": {
      "type": "string",
      "enum": [
        "Per Day",
        "Per Instance",
        "Other",
        "Unknown"
      ],
      "default": "Unknown",
      "title": "CMP Type"
    },
    "verified_daily_rate": {
      "type": "number",
      "title": "Verified Daily Rate"
    },
    "dpna_present": {
      "type": "string",
      "enum": [
        "Yes",
        "No",
        "Unknown"
      ],
      "default": "Unknown",
      "title": "DPNA Present"
    },
    "dpna_effective_date": {
      "type": "string",
      "format": "date"
    },
    "ij_start_date": {
      "type": "string",
      "format": "date"
    },
    "ij_removal_date": {
      "type": "string",
      "format": "date"
    },
    "sff_status": {
      "type": "string",
      "enum": [
        "Not SFF",
        "SFF Candidate",
        "Active SFF",
        "Unknown"
      ],
      "default": "Unknown"
    },
    "scope_severity": {
      "type": "string",
      "title": "Scope & Severity"
    },
    "survey_date": {
      "type": "string",
      "format": "date"
    },
    "revisit_date": {
      "type": "string",
      "format": "date"
    },
    "revisit_status": {
      "type": "string"
    },
    "substantial_compliance_status": {
      "type": "string"
    }
  },
  "required": [
    "facility_name",
    "signal_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "clinical"
          }
        },
        {
          "user_condition": {
            "role": "read_only"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "clinical"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "clinical"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}