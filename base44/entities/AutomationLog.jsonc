{
  "name": "AutomationLog",
  "type": "object",
  "properties": {
    "automation": {
      "type": "string"
    },
    "started": {
      "type": "string",
      "format": "date-time"
    },
    "completed": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "Running",
        "Success",
        "Failed",
        "Partial",
        "Retry"
      ],
      "default": "Running"
    },
    "records_processed": {
      "type": "number"
    },
    "errors": {
      "type": "string"
    },
    "retry_state": {
      "type": "string"
    },
    "affected_record_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "triggered_by": {
      "type": "string"
    },
    "client_account_id": {
      "type": "string",
      "title": "Client Account ID"
    },
    "previous_access_state": {
      "type": "string",
      "title": "Previous Access State"
    },
    "new_access_state": {
      "type": "string",
      "title": "New Access State"
    },
    "reason": {
      "type": "string",
      "title": "Reason"
    },
    "triggering_source": {
      "type": "string",
      "title": "Triggering Source"
    },
    "acting_user_id": {
      "type": "string",
      "title": "Acting User ID"
    },
    "acting_user_name": {
      "type": "string",
      "title": "Acting User Name"
    },
    "manual_override": {
      "type": "boolean",
      "default": false,
      "title": "Manual Override Applied"
    },
    "manual_override_details": {
      "type": "string",
      "title": "Manual Override Details"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "automation",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}