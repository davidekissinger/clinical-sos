{
  "name": "Engagement",
  "type": "object",
  "properties": {
    "engagement_name": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "opportunity_id": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "estimated_end_date": {
      "type": "string",
      "format": "date"
    },
    "service_type": {
      "type": "string"
    },
    "phase": {
      "type": "string",
      "enum": [
        "Phase 1 \u2014 Initial Assessment",
        "Phase 2 \u2014 POC/Improvement Development",
        "Phase 3 \u2014 Implementation/Stabilization/Follow-Up",
        "Onboarding",
        "Complete"
      ]
    },
    "engagement_model": {
      "type": "string",
      "enum": [
        "Fixed Fee",
        "Hourly",
        "Time and Expense",
        "Hybrid"
      ],
      "title": "Engagement Model"
    },
    "accepted_proposal_id": {
      "type": "string",
      "title": "Accepted Proposal ID"
    },
    "accepted_proposal_name": {
      "type": "string",
      "title": "Accepted Proposal Name"
    },
    "manager_id": {
      "type": "string"
    },
    "manager_name": {
      "type": "string"
    },
    "clinical_lead_id": {
      "type": "string"
    },
    "clinical_lead_name": {
      "type": "string"
    },
    "deliverables": {
      "type": "string"
    },
    "milestones": {
      "type": "string"
    },
    "invoice_milestones": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "On Hold",
        "Complete",
        "Cancelled"
      ]
    },
    "client_visibility": {
      "type": "boolean",
      "default": false,
      "title": "Client Visible"
    },
    "is_test_data": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "engagement_name",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "clinical"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        },
        {
          "user_condition": {
            "role": "read_only"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "client"
              }
            },
            {
              "data.client_visibility": true
            },
            {
              "id": {
                "$in": "{{user.data.authorized_engagement_ids}}"
              }
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "clinical"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "clinical"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}