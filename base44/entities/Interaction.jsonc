{
  "name": "Interaction",
  "type": "object",
  "properties": {
    "interaction_type": {
      "type": "string",
      "enum": [
        "Email",
        "Inbound Form",
        "Phone",
        "Meeting",
        "Note",
        "Follow-Up",
        "Proposal",
        "Other"
      ]
    },
    "direction": {
      "type": "string",
      "enum": [
        "Inbound",
        "Outbound",
        "Internal"
      ]
    },
    "team_member_id": {
      "type": "string"
    },
    "team_member_name": {
      "type": "string"
    },
    "contact_id": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "facility_id": {
      "type": "string"
    },
    "facility_name": {
      "type": "string"
    },
    "opportunity_id": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "next_step": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "is_test_data": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "interaction_type",
    "summary"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "business_development"
          }
        },
        {
          "user_condition": {
            "role": "clinical"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "business_development"
          }
        },
        {
          "user_condition": {
            "role": "clinical"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "business_development"
          }
        },
        {
          "user_condition": {
            "role": "clinical"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}