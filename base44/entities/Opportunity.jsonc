{
  "name": "Opportunity",
  "type": "object",
  "properties": {
    "opportunity_name": {
      "type": "string"
    },
    "lead_id": {
      "type": "string"
    },
    "facility_id": {
      "type": "string"
    },
    "facility_name": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "organization_name": {
      "type": "string"
    },
    "primary_contact_id": {
      "type": "string"
    },
    "primary_contact_name": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "New",
        "Researching",
        "Verified",
        "Qualified",
        "Outreach Review",
        "Contacted",
        "Engaged",
        "Discovery Scheduled",
        "Discovery Completed",
        "Proposal Draft",
        "Proposal Sent",
        "Negotiation",
        "Won",
        "Lost",
        "Nurture",
        "Suppressed"
      ]
    },
    "estimated_value": {
      "type": "number"
    },
    "probability": {
      "type": "number"
    },
    "expected_close": {
      "type": "string",
      "format": "date"
    },
    "service_interest": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "reason_lost": {
      "type": "string"
    },
    "lead_tier": {
      "type": "string"
    },
    "regulatory_urgency": {
      "type": "string",
      "enum": [
        "Critical",
        "Severe",
        "High",
        "Moderate",
        "Proactive",
        "Unknown / Research Required"
      ],
      "default": "Unknown / Research Required"
    },
    "regulatory_urgency_score": {
      "type": "number"
    },
    "commercial_opportunity_score": {
      "type": "number"
    },
    "clinical_sos_priority_score": {
      "type": "number"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "is_test_data": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "opportunity_name",
    "stage"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "business_development"
          }
        },
        {
          "user_condition": {
            "role": "clinical"
          }
        },
        {
          "user_condition": {
            "role": "read_only"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "finance"
              }
            },
            {
              "data.stage": "Won"
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "business_development"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "business_development"
          }
        },
        {
          "user_condition": {
            "role": "clinical"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}